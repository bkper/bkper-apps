{
    "_metadata": {
        "major_version": 2,
        "minor_version": 1
    },
    "display_information": {
        "name": "Bkper",
        "description": "Ask about your Bkper Books, right in Slack.",
        "background_color": "#1d4ed8"
    },
    "features": {
        "app_home": {
            "home_tab_enabled": true,
            "messages_tab_enabled": true,
            "messages_tab_read_only_enabled": false
        },
        "bot_user": {
            "display_name": "bkper",
            "always_online": true
        },
        "agent_view": {
            "agent_description": "Answers questions about your Bkper Books and works on them: acts as each person, with their own Bkper account."
        }
    },
    "oauth_config": {
        "redirect_urls": [
            "https://channels.bkper.app/slack/bkper-slack/callback"
        ],
        "scopes": {
            "bot": [
                "app_mentions:read",
                "assistant:write",
                "channels:history",
                "chat:write",
                "files:read",
                "files:write",
                "groups:history",
                "im:history",
                "users:read"
            ]
        }
    },
    "settings": {
        "event_subscriptions": {
            "request_url": "https://channels.bkper.app/slack/bkper-slack/events",
            "bot_events": [
                "agent_session_stopped",
                "app_home_opened",
                "app_mention",
                "app_uninstalled",
                "message.im",
                "tokens_revoked",
                "user_change"
            ]
        },
        "interactivity": {
            "is_enabled": true,
            "request_url": "https://channels.bkper.app/slack/bkper-slack/interactions"
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "token_rotation_enabled": false
    }
}
