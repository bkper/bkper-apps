{
  "openapi": "3.0.3",
  "info": {
    "title": "Bookbot Completion API",
    "version": "1.0.0",
    "description": "Completes draft transactions without Book writes: fills a missing amount, and a date Bkper filled in automatically (auto_filled_date_), from the description, then discovers Accounts and historical properties. A supplied amount or a date the user chose is never replaced. Canonical transaction payloads are enriched locally. Existing discovery preserves supplied Account sides and visible properties, consumes parsed_account_name_, and updates its internal bookbot_* provenance. sourceAccount enables property enrichment from the history found by account discovery. Items run sequentially, reusing one discovery cache per target Book and its existing request limit. Item IDs are unique within a batch and are unrelated to native transaction IDs. No installation is required; every target Book requires read access. Creator hints are verified and never select permissions or AI allowance. The Platform owns authentication, app-chain attribution and AI allowance. When similar posted history used several Accounts, Jev ranks them; its confidence, or 1.00 for a single Account, is recorded in bookbot_confidence_. No history datasets are returned. changed means an amount, date, Account or property was filled; otherwise no_change means both sides are supplied or the description is blank, and no_match means discovery returned no Accounts. Errors return the original supplied transaction, including when only part of discovery succeeded."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/complete": {
      "post": {
        "operationId": "complete",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletionItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read-only completion results. Inspect each item outcome and error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or duplicate item identifiers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Platform authentication required."
          }
        }
      }
    },
    "/api/v1/complete/batch": {
      "post": {
        "operationId": "completeBatch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletionBatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Read-only completion results. Inspect each item outcome and error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionBatchResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or duplicate item identifiers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Platform authentication required."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Account": {
        "$id": "#/components/schemas/Account",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": {},
        "x-typescript-type": "bkper.Account"
      },
      "Transaction": {
        "$id": "#/components/schemas/Transaction",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "createdBy": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "creditAccount": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Account"
              }
            ]
          },
          "debitAccount": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Account"
              }
            ]
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": {},
        "x-typescript-type": "bkper.Transaction"
      },
      "CompletionItem": {
        "$id": "#/components/schemas/CompletionItem",
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1
          },
          "bookId": {
            "type": "string",
            "minLength": 1
          },
          "transaction": {
            "$ref": "#/components/schemas/Transaction"
          },
          "sourceAccount": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Account"
              }
            ]
          }
        },
        "required": [
          "itemId",
          "bookId",
          "transaction"
        ],
        "additionalProperties": false
      },
      "CompletionResult": {
        "$id": "#/components/schemas/CompletionResult",
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string"
          },
          "bookId": {
            "type": "string"
          },
          "transaction": {
            "$ref": "#/components/schemas/Transaction"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "changed",
              "no_change",
              "no_match",
              "error"
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "itemId",
          "bookId",
          "transaction",
          "outcome"
        ],
        "additionalProperties": false
      },
      "CompletionBatch": {
        "$id": "#/components/schemas/CompletionBatch",
        "type": "object",
        "properties": {
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompletionItem"
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "CompletionBatchResult": {
        "$id": "#/components/schemas/CompletionBatchResult",
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompletionResult"
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "$id": "#/components/schemas/ErrorResponse",
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
