{
  "paths": {
    "/api/v1/analyze": {
      "post": {
        "tags": [
          "Duplicate review"
        ],
        "summary": "Analyze up to 1,000 submitted Book transactions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI-ranked, deterministically non-overlapping suggestions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "402": {
            "description": "Subscription payment required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "AI allowance exhausted or provider throttled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "AI providers unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/merge": {
      "post": {
        "tags": [
          "Duplicate review"
        ],
        "summary": "Merge one confirmed pair with the canonical Bkper merge operation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MergeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full canonical merged transaction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MergeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/learn": {
      "post": {
        "tags": [
          "Duplicate review"
        ],
        "summary": "Save rejected pairs as plain-text learning examples",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LearnRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full updated learning resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "AnalyzeResponse": {
        "type": "object",
        "properties": {
          "suggestions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            }
          },
          "skipped": {
            "$ref": "#/components/schemas/SkippedCounts"
          }
        },
        "required": [
          "suggestions",
          "skipped"
        ]
      },
      "Suggestion": {
        "type": "object",
        "properties": {
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "strength": {
            "type": "string",
            "enum": [
              "Strong",
              "Possible"
            ]
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "transactions",
          "strength",
          "explanation"
        ]
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "dateFormatted": {
            "type": "string"
          },
          "dateValue": {
            "type": "integer"
          },
          "amount": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "posted": {
            "type": "boolean"
          },
          "draft": {
            "type": "boolean"
          },
          "checked": {
            "type": "boolean"
          },
          "trashed": {
            "type": "boolean"
          },
          "creditAccount": {
            "$ref": "#/components/schemas/Account"
          },
          "debitAccount": {
            "$ref": "#/components/schemas/Account"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            }
          },
          "remoteIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "agentId": {
            "type": "string"
          },
          "agentName": {
            "type": "string"
          },
          "agentLogo": {
            "type": "string"
          },
          "agentLogoDark": {
            "type": "string"
          },
          "createdBy": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "nullable": true
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "normalizedName": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ASSET",
              "LIABILITY",
              "INCOMING",
              "OUTGOING"
            ]
          },
          "credit": {
            "type": "boolean"
          },
          "permanent": {
            "type": "boolean"
          },
          "archived": {
            "type": "boolean"
          },
          "balance": {
            "type": "string"
          },
          "balanceVerified": {
            "type": "boolean"
          },
          "hasTransactionPosted": {
            "type": "boolean"
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Group"
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "agentId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "nullable": true
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "normalizedName": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ASSET",
              "LIABILITY",
              "INCOMING",
              "OUTGOING"
            ]
          },
          "credit": {
            "type": "boolean"
          },
          "permanent": {
            "type": "boolean"
          },
          "mixed": {
            "type": "boolean"
          },
          "hidden": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          },
          "hasAccounts": {
            "type": "boolean"
          },
          "hasGroups": {
            "type": "boolean"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "agentId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "nullable": true
        }
      },
      "File": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "url": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "agentId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "nullable": true
        }
      },
      "SkippedCounts": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "checked": {
            "type": "integer",
            "minimum": 0
          },
          "trashed": {
            "type": "integer",
            "minimum": 0
          },
          "locked": {
            "type": "integer",
            "minimum": 0
          },
          "invalid": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "total",
          "checked",
          "trashed",
          "locked",
          "invalid"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "AnalyzeRequest": {
        "type": "object",
        "properties": {
          "bookId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "maxItems": 1000
          }
        },
        "required": [
          "bookId",
          "transactions"
        ]
      },
      "MergeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "dateFormatted": {
            "type": "string"
          },
          "dateValue": {
            "type": "integer"
          },
          "amount": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "posted": {
            "type": "boolean"
          },
          "draft": {
            "type": "boolean"
          },
          "checked": {
            "type": "boolean"
          },
          "trashed": {
            "type": "boolean"
          },
          "creditAccount": {
            "$ref": "#/components/schemas/Account"
          },
          "debitAccount": {
            "$ref": "#/components/schemas/Account"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            }
          },
          "remoteIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "agentId": {
            "type": "string"
          },
          "agentName": {
            "type": "string"
          },
          "agentLogo": {
            "type": "string"
          },
          "agentLogoDark": {
            "type": "string"
          },
          "createdBy": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "nullable": true
        }
      },
      "MergeRequest": {
        "type": "object",
        "properties": {
          "bookId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "primary": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Transaction"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": {
                  "nullable": true
                }
              }
            ]
          },
          "secondary": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Transaction"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": {
                  "nullable": true
                }
              }
            ]
          }
        },
        "required": [
          "bookId",
          "primary",
          "secondary"
        ]
      },
      "LearnResponse": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "book": {
                "$ref": "#/components/schemas/Book"
              }
            },
