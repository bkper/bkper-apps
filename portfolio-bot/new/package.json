{
    "name": "portfolio-bot",
    "private": true,
    "workspaces": [
        "client",
        "server"
    ],
    "scripts": {
        "clean": "rm -rf node_modules dist client/node_modules server/node_modules",
        "predev": "bun install --frozen-lockfile",
        "dev": "concurrently \"bun run dev:client\" \"bun run dev:server\"",
        "dev:client": "bun --cwd client dev",
        "dev:server": "bkper app dev --sp 8797 --cp 5179",
        "prebuild": "bun install --frozen-lockfile",
        "build": "bun run api && bun run typecheck && bun run build:client && bun run build:server",
        "build:client": "bun --cwd client build",
        "build:server": "bkper app build",
        "test": "bun run test:client && bun run test:server",
        "test:client": "bun --cwd client test",
        "test:server": "bun --cwd server test",
        "typecheck": "bun run typecheck:client && bun run typecheck:server",
        "typecheck:client": "bun --cwd client typecheck",
        "typecheck:server": "bun --cwd server typecheck",
        "api": "bun scripts/generate-api-types.ts",
        "format:check": "prettier --check .",
        "generated:check": "git diff --exit-code -- client/src/api/generated/types.d.ts env.d.ts .dev.vars.example",
        "check": "bun run api && bun run typecheck && bun run test && bun run build:client && bun run build:server && bun run format:check && bun run generated:check",
        "deploy": "bun run build && bkper app sync && bkper app deploy",
        "deploy:preview": "bun run build && bkper app sync && bkper app deploy --preview"
    },
    "devDependencies": {
        "bkper": "4.24.3",
        "concurrently": "9.2.4",
        "miniflare": "4.20260730.0",
        "openapi-typescript": "7.13.0",
        "prettier": "3.9.6",
        "typescript": "5.9.3"
    }
}
