{
  "paths": {
    "/api/v1/ping": {
      "get": {
        "tags": [
          "API"
        ],
        "summary": "Ping app API",
        "responses": {
          "200": {
            "description": "API is reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponse"
                }
              }
            }
          },
          "default": {
            "description": "API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "schemas": {
    "PingResponse": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "example": true
        },
        "source": {
          "type": "string",
          "example": "report"
        }
      },
      "required": [
        "ok",
        "source"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "example": "INTERNAL_ERROR"
            },
            "message": {
              "type": "string",
              "example": "An unexpected error occurred"
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  }
}
