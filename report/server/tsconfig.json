{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "noEmit": true,
        "types": ["@bkper/bkper-api-types"],
        "lib": ["ES2022", "ES2023.Intl", "WebWorker"],
        "resolveJsonModule": true
    },
    "include": ["src/**/*.ts", "../env.d.ts"]
}
