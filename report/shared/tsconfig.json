{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "noEmit": true,
        "lib": ["ES2022"],
        "types": []
    },
    "include": ["src/**/*.ts", "test/**/*.ts"]
}
